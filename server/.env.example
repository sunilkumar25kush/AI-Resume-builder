# Server environment — copy to .env and fill values
NODE_ENV=development

# Port for the API server (5000 is used by the ChatApp dev server — keep 5001)
PORT=5001

# MongoDB Atlas connection string (no local mongod required)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-resume-builder

# Auth (required from M2 onwards)
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# CORS origin for the client
CORS_ORIGIN=http://localhost:5173

# Google OAuth (optional — hides Google button when unset)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI provider: ollama | gemini
AI_PROVIDER=ollama

# Ollama (primary)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=milanjeremic2/deepseek-r1-32b-uncensored

# Gemini (optional fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
